# ==============================================================================
# PhishGuard AI - Environment Configuration Example
# ==============================================================================

# Database
# Default: SQLite for immediate local zero-config running
# Production: postgresql+psycopg2://postgres:postgres@localhost:5432/phishguard
DATABASE_URL=sqlite:///./phishguard.db

# JWT Security
JWT_SECRET=phishguard_super_secret_production_key_replace_with_crypto_random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External Intelligence Providers (Optional - degraded safe offline mode if empty)
AI_API_KEY=
AI_PROVIDER=mock
THREAT_INTELLIGENCE_API_KEY=

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# App Settings
DEMO_MODE=false
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
